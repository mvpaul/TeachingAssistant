# Backend (FastAPI) - copy to .env and fill in
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-opus-5
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (Vite) - read as import.meta.env.VITE_*
VITE_API_ENDPOINT=http://localhost:8000/api/ai

# APNs (iOS Live Activity push updates - see ios/README.md)
# Optional: if unset, Live Activity updates are silently skipped and the
# rest of the app (web + basic tutoring) works fine without them.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_PATH=
APNS_BUNDLE_ID=com.yourteam.tutor
APNS_ENVIRONMENT=sandbox
